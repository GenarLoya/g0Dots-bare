// hidrot theme - niri colors
* {
  bg0: #141414;
  bg1: #202020;
  fg0: #e6e9ef;
  fg1: #b0b0b0;
  orange: #df6124;
  orange-trans: #df612415;
}

window {
  fullscreen: true;
  background-color: rgba(20, 20, 20, 0.9);
  border: 0;
  border-radius: 0;
  padding: 0;
}

mainbox {
  children: [inputbar, listview];
  padding: 10%;
  spacing: 4em;
}

inputbar {
  background-color: rgba(32,32,32,0.85);
  children: [prompt, entry];
  border-radius: 5px;
  margin: 0 30%;
  padding: 0.9em;
  spacing: 0.5em;
}

prompt {
  padding: 0 0.5em 0 0;
  text-color: #df6124;
}

entry {
  placeholder: "Search:";
  placeholder-color: rgba(255,255,255,0.5);
  text-color: #e6e9ef;
}

listview {
  columns: 8;
  fixed-columns: true;
  layout: horizontal;
  lines: 0;
}

element {
  border-radius: 5px;
  orientation: vertical;
  padding: 2em;
  children: [element-icon, element-text];
  spacing: 0.5em;
}

element selected {
  background-color: rgba(32,32,32,0.85);
}

element-icon {
  size: 2em;
}

element-text {
  highlight: none;
  horizontal-align: 0.5;
  text-color: #e6e9ef;
}
