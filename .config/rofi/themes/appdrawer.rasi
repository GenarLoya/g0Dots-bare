/* Launcher de aplicaciones — Aura Theme + estructura g0Dots
 * Usado por:
 *   • Waybar  → custom/launcher
 *   • Hyprland → SUPER + space (modules/keybinds.lua)
 *
 * Uso: rofi -show drun -theme ~/.config/rofi/themes/appdrawer.rasi
 */

@theme "~/.config/rofi/themes/base.rasi"

configuration {
    modi: "drun";
    display-drun: "Aplicaciones";
    drun-display-format: "{name}";
    matching: "fuzzy";
    sort: true;
    show-icons: true;
    /* Papirus no está instalado: rofi usa el tema por defecto (Adwaita). */
    icon-theme: "hicolor";
    drun-icon-display-mode: 3;
}

window {
    width: 440px;
    height: 60%;
}
