// Waybar — tema "V1.9b" (HANCORE-linux/waybar-themes) adaptado a Hyprland.
//
// Estructura de la referencia:
//   reloj | indicadores | [workspaces] [mpris][backlight][bluetooth][network]
//          [pulseaudio][battery][memory][cpu]
//
// Módulos de Omarchy no disponibles aquí -> se omiten o se sustituyen
// por equivalentes locales (launcher, clipboard, powermenu, red, cpu, memoria).
{
  "layer": "top",
  "position": "top",
  "height": 0,

  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 4,
  "margin-right": 4,

  "spacing": 0,
  "reload_style_on_change": true,

  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "group/right"
  ],

  "group/right": {
    "orientation": "inherit",
    "modules": [
      "bluetooth",
      "network",
      "pulseaudio",
      "battery",
      "memory",
      "cpu"
    ]
  },

  // Reloj + fecha (formato de la referencia).
  "clock": {
    "format": "{:%H:%M - %a, %d}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "month": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    }
  },

  // Separador vertical "|" entre grupos.
  "custom/separator": {
    "format": "|",
    "tooltip": false
  },

  // Workspaces de Hyprland.
  "hyprland/workspaces": {
    "on-click": "activate",
    "cursor": true,
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{id}",
    "tooltip-format": "{id}"
  },

  // Lanzador de aplicaciones (rofi drun).
  "custom/launcher": {
    "format": "󰣇",
    "on-click": "vicinae toggle",
    "tooltip": true
  },

  // Historial del clipboard (Vicinae, Wayland nativo).
  "custom/clipboard": {
    "format": "󰅌",
    "on-click": "vicinae 'vicinae://launch/clipboard/history?toggle=true'",
    "tooltip": true
  },

  // BlueTooth.
  "bluetooth": {
    "format": "󰂲 {status} {num_connections}",
    "format-off": "󰂲 OFF",
    "format-disabled": "󰂲 {status}",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "bluetoothctl power toggle"
  },

  // Red: señal wifi / velocidad ethernet.
  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon} {signalStrength}%",
    "format-ethernet": "󰈀 {bandwidthDownBytes:=}",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1
  },

  // Volumen.
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰕾",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", "", ""]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%-"
  },

  // Batería con barra de progreso.
  "battery": {
    "format": "{icon} {capacity}%",
    "format-discharging": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "format-plugged": "",
    "format-icons": {
      "charging": [
        "󰢜 <span size='8pt' color='#82e2ff'>━━━━━━━━━━</span>",
        "󰢜 <span size='8pt' color='#82e2ff'>■━━━━━━━━━</span>",
        "󰂆 <span size='8pt' color='#6fd4f0'>■■━━━━━━━━</span>",
        "󰂇 <span size='8pt' color='#5cc6e1'>■■■━━━━━━━</span>",
        "󰂈 <span size='8pt' color='#49b8d2'>■■■■━━━━━━</span>",
        "󰢝 <span size='8pt' color='#36aac3'>■■■■■━━━━━</span>",
        "󰂉 <span size='8pt' color='#269cb4'>■■■■■■━━━━</span>",
        "󰢞 <span size='8pt' color='#168ea5'>■■■■■■■━━━</span>",
        "󰂊 <span size='8pt' color='#0a8096'>■■■■■■■■━━</span>",
        "󰂋 <span size='8pt' color='#037287'>■■■■■■■━━━</span>",
        "󰂅 <span size='8pt' color='#016478'>■■■■■■■■</span>"
      ],
      "default": [
        "󰁺 <span size='8pt' color='#82e2ff'>━━━━━━━━━━</span>",
        "󰁺 <span size='8pt' color='#82e2ff'>■━━━━━━━━━</span>",
        "󰁻 <span size='8pt' color='#6fd4f0'>■■━━━━━━━━</span>",
        "󰁼 <span size='8pt' color='#5cc6e1'>■■■━━━━━━━</span>",
        "󰁽 <span size='8pt' color='#49b8d2'>■■■■━━━━━━</span>",
        "󰁾 <span size='8pt' color='#36aac3'>■■■■■━━━━━</span>",
        "󰁿 <span size='8pt' color='#269cb4'>■■■■■■━━━━</span>",
        "󰂀 <span size='8pt' color='#168ea5'>■■■■■■■━━━</span>",
        "󰂁 <span size='8pt' color='#0a8096'>■■■■■■■■━━</span>",
        "󰂂 <span size='8pt' color='#037287'>■■■■■■■━━━</span>",
        "󰁹 <span size='8pt' color='#016478'>■■■■■■■■</span>"
      ]
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{timeTo}",
    "tooltip-format-charging": "{timeTo}",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    }
  },

  // Memoria: barra + GB usados.
  "memory": {
    "interval": 2,
    "format": "<span size='9pt'>󰍛</span> {icon} {used:0.1f}G",
    "format-icons": [
      "<span size='8pt'>━━━━━━━━━━</span>",
      "<span size='8pt'>■━━━━━━━━━</span>",
      "<span size='8pt' color='#ffb0b0'>■■━━━━━━━━</span>",
      "<span size='8pt' color='#ff9a9a'>■■■━━━━━━━</span>",
      "<span size='8pt' color='#ff8484'>■■■■━━━━━━</span>",
      "<span size='8pt' color='#ff7676'>■■■■■━━━━━</span>",
      "<span size='8pt' color='#ff6e6e'>■■■■■■━━━━</span>",
      "<span size='8pt' color='#ff6767'>■■■■■■■━━━</span>",
      "<span size='8pt' color='#f65f5f'>■■■■■■■■━━</span>",
      "<span size='8pt' color='#e65757'>■■■■■■■■■━</span>",
      "<span size='8pt' color='#d64f4f'>■■■■■■■■■■</span>"
    ]
  },

  // CPU: barra + porcentaje.
  "cpu": {
    "interval": 2,
    "format": "<span size='10pt'></span> {icon} {usage}%",
    "format-icons": [
      "<span size='8pt'>━━━━━━━━━━</span>",
      "<span size='8pt'>■━━━━━━━━━</span>",
      "<span size='8pt' color='#f694ff'>■■━━━━━━━━</span>",
      "<span size='8pt' color='#e986ff'>■■■━━━━━━━</span>",
      "<span size='8pt' color='#d878ff'>■■■■━━━━━━</span>",
      "<span size='8pt' color='#c56aff'>■■■■■━━━━━</span>",
      "<span size='8pt' color='#b25cff'>■■■■■■━━━━</span>",
      "<span size='8pt' color='#a277ff'>■■■■■■■━━━</span>",
      "<span size='8pt' color='#9169ff'>■■■■■■■■━━</span>",
      "<span size='8pt' color='#805bff'>■■■■■■■■■━</span>",
      "<span size='8pt' color='#6f4dff'>■■■■■■■■■■</span>"
    ]
  },

  // Reproductor multimedia.
  "mpris": {
    "format": "<span size='9pt'></span>",
    "format-paused": "<span size='9pt'>{status_icon}</span>",
    "max-length": 5,
    "player-icons": {
      "default": "⏸",
      "mpv": "🎵"
    },
    "status-icons": {
      "paused": "󰝛"
    },
    "ignored-players": ["firefox", "chromium", "brave"]
  },

  // System tray.
  "tray": {
    "icon-size": 12,
    "spacing": 5
  }
}
