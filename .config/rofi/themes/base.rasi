/* Base — Aura Theme (https://github.com/daltonmenezes/aura-theme)
 * Estructura basada en el tema propio de g0Dots
 * (https://github.com/GenarLoya/g0Dots/tree/main/rofi/.config/rofi)
 * Colores compartidos por appdrawer.rasi y powermenu.rasi.
 */

* {
  font: "JetBrainsMono Nerd Font 12";
  /* Aura Theme */
  bg0     : #15141b;
  bg1     : #1b1a23;
  bg2     : #24232e;
  bg3     : #3d375e7f;
  fg0     : #edecee;
  fg1     : #bdbdbd;
  fg2     : #6d6d6d;
  purple  : #a277ff;
  green   : #61ffca;
  orange  : #ffca85;
  pink    : #f694ff;
  blue    : #82e2ff;
  red     : #ff6767;

  accent  : @purple;
  urgent  : @red;

  background-color : transparent;
  text-color       : @fg0;

  margin  : 0;
  padding : 0;
  spacing : 0;
}

element-icon, element-text, scrollbar {
  cursor: pointer;
}

prompt {
  width: 100%;
  padding: 0px;
  border-radius: 0px;
  text-color: @green;
}

window {
  location : north;
  anchor   : center;
  width    : 440px;
  x-offset : 0px;
  y-offset : 44px;

  background-color: @bg1;
  border: 1px;
  border-color: @bg3;
  border-radius: 10px;
  children: [ headerbar, inputbar, listview ];
}

/* Cabecera: icono + prompt (como en g0Dots). */
headerbar {
  orientation: horizontal;
  children: [ icon-search, prompt ];
  expand: false;
  background-color: @bg0;
  padding: 4px 10px;
  margin: 0px;
  border-radius: 10px 10px 0px 0px;
}

inputbar {
  spacing  : 15px;
  padding  : 4px 10px;
  children : [ entry ];
  background-color: @bg0;
}

icon-search, entry, element-icon, element-text {
  vertical-align: 0.5;
}

entry {
  placeholder: "Buscar...";
  placeholder-color: @fg2;
  background-color: transparent;
  text-color: @fg0;
  border-bottom: 0px;
  padding: 0px;
}

icon-search {
  text-color: @green;
  expand   : false;
  filename : "~/.config/rofi/icons/thunder.svg";
  size     : 16px;
  padding  : 0px 6px 0px 0px;
  margin   : 0px 0px 0px 0px;
}

textbox {
  padding          : 4px 8px;
  background-color : @bg2;
  text-color       : @fg1;
}

listview {
  padding      : 4px 0px;
  lines        : 12;
  columns      : 1;
  scrollbar    : true;
  fixed-height : false;
  dynamic      : true;
}

element {
  padding : 7px 10px;
  spacing : 8px;
  border-radius : 6px;
}

element normal urgent {
  text-color: @urgent;
}

element normal active {
  text-color: @accent;
}

element alternate active {
  text-color: @accent;
}

element selected {
  text-color       : @bg0;
  background-color : @purple;
}

element selected urgent {
  background-color : @red;
}

element-icon {
  size: 0.8em;
  vertical-align: 0.5;
}

element-text {
  text-color: inherit;
}

scrollbar {
  handle-width : 4px;
  handle-color : @fg2;
  padding      : 0 4px;
}
