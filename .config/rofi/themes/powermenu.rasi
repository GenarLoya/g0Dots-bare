/* Powermenu (menú de sesión) — Aura Theme + estructura g0Dots
 * Usado por:
 *   • Waybar  → custom/powermenu
 *   • Hyprland → SUPER + SHIFT + ESCAPE (modules/keybinds.lua)
 *
 * Uso: rofi -dmenu -p "Sesión" -theme ~/.config/rofi/themes/powermenu.rasi
 */

@theme "~/.config/rofi/themes/base.rasi"

configuration {
    modi: "dmenu";
    display-dmenu: "Sesión";
    dmenu-display-format: "{}";
    show-icons: false;
}

window {
    width: 320px;
}
