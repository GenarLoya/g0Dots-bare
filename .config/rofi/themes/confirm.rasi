// Global
* {
    background-color: transparent;
    text-color: rgba(255, 255, 255, 1);
    font: "JetBrainsMono Nerd Font 20";
}

// Window
window {
    fullscreen: true;
    background-color: rgba(20, 20, 20, 0.9);
}

// Main Box
mainbox {
    padding: 15% 20%;
    children: ["prompt", "listview"];
    spacing: 3em;
}

// Message
message {
    padding: 20px;
    horizontal-align: 0.5;
    font-size: 32px;
}

prompt {
    font-size: 28px;
}

// List View
listview {
    columns: 2;
    spacing: 2em;
    cycle: false;
}
element {
    padding: 1em;
    border-radius: 5px;
}
element-text {
    horizontal-align: 0.5;
    font-size: 20px;
}
element.selected {
    background-color: rgba(32, 32, 32, 0.85);
}
