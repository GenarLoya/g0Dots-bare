// hidrot theme - niri colors
* {
  bg0: #141414;
  bg1: #202020;
  fg0: #e6e9ef;
  fg1: #b0b0b0;
  orange: #df6124;
  orange-trans: #df612480;
}

window {
  background-color: #141414;
  border: 2px;
  border-color: rgba(223, 97, 36, 0.5);
  border-radius: 6px;
  padding: 6px;
}

mainbox {
  children: [inputbar, listview];
}

inputbar {
  background-color: rgba(223, 97, 36, 0.2);
  border: 0 0 0 2px;
  border-color: #df6124;
  border-radius: 6px;
  margin: 0 0 6px 0;
}

entry {
  padding: 10px;
  text-color: #df6124;
}

listview {
  lines: 10;
}

element {
  border: 0 0 0 2px;
  border-color: transparent;
  border-radius: 6px;
  padding: 10px;
}

element selected {
  background-color: rgba(223, 97, 36, 0.2);
  border-color: #df6124;
}

element-text {
  text-color: #e6e9ef;
}

element-text selected {
  text-color: #df6124;
}
