// hidrot theme - adapted with niri orange colors
window {
    background-color: rgba(20, 20, 20, 0.95);
    border: 2px;
    border-color: rgba(223, 97, 36, 1);
    border-radius: 6px;
    padding: 6px;
}

mainbox {
    children: [inputbar, listview];
}

inputbar {
    background-color: rgba(32, 32, 32, 0.85);
    border: 0 0 0 2px;
    border-color: rgba(223, 97, 36, 1);
    border-radius: 6px;
    margin: 0 0 6px 0;
    padding: 4px;
}

prompt {
    background-color: rgba(223, 97, 36, 1);
    text-color: rgba(20, 20, 20, 0.95);
    padding: 10px 14px;
    border-radius: 4px;
    margin: 2px;
}

entry {
    padding: 10px;
    text-color: rgba(223, 97, 36, 1);
    placeholder-color: rgba(255, 255, 255, 0.5);
}

listview {
    lines: 10;
}

element {
    border: 0 0 0 2px;
    border-radius: 6px;
    padding: 10px;
}

element selected {
    background-color: rgba(223, 97, 36, 0.25);
    border-color: rgba(223, 97, 36, 1);
}

element-text {
    text-color: rgba(255, 255, 255, 0.9);
}

element-text selected {
    text-color: rgba(223, 97, 36, 1);
}
